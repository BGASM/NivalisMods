<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NivalisOrderFix</AssemblyName>
    <Version>2.1.0</Version>
    <TsName>BetterSupplierChoice</TsName>
    <TsDescription>Choose which vendors your managers buy ingredients from: cheapest, nearest, or a balance of price, distance and stock. Settings in the Mods menu.</TsDescription>
    <TsWebsite>https://github.com/BGASM/NivalisMods</TsWebsite>
    <TsDependencies>$(KitDependency)</TsDependencies>
  </PropertyGroup>
  <ItemGroup>
    <!-- The kit as an outside modder references it: the installed DLL (github.com/BGASM/NivalisModKit). Build and
         install the kit first; its NivalisModKit.xml beside the DLL gives in-editor docs. -->
    <Reference Include="NivalisModKit"><HintPath>$(GameDir)\BepInEx\plugins\NivalisModKit.dll</HintPath><Private>false</Private></Reference>
    <!-- The kit's window rows (KitWindow, for the Mods browser page) use TextMeshPro and Unity UI types. -->
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameDir)\BepInEx\interop\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
