<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NivalisCursor</AssemblyName>
    <Version>1.0.0</Version>
    <TsName>NivalisCursor</TsName>
    <TsDescription>A free mouse cursor on demand (scroll-wheel click by default, reassignable): movement and mouse-look pause until you press it again.</TsDescription>
    <TsWebsite>https://github.com/BGASM/NivalisMods</TsWebsite>
    <TsDependencies>$(KitDependency)</TsDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NivalisModKit"><HintPath>$(GameDir)\BepInEx\plugins\NivalisModKit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(GameDir)\BepInEx\interop\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
